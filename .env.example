# Local development (production setup: DEPLOY.md)
# Set DATABASE_URL on Vercel. Leave blank only for local JSON storage.
DATABASE_URL=
PORT=3000
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
APP_ORIGIN=http://127.0.0.1:3000
# OAuth identity only, no following-list verification.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/api/x/callback
